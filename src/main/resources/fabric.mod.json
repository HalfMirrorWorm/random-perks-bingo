{
  "schemaVersion": 1,
  "id": "random-perks-bingo",
  "version": "$version",
  "name": "Random Perks Bingo",
  "description": "随机词条 Bingo 扩展: 完成 bingo 格子后从随机词条中三选一, 构筑本局专属流派。 / Random perk draft system for Yet Another Bingo.",
  "license": "LGPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.randomperks.RandomPerksMod"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.randomperks.client.RandomPerksClient"
      }
    ]
  },
  "mixins": [
    {
      "config": "mixins.randomperks.json",
      "environment": "*"
    },
    {
      "config": "mixins.randomperks.compass.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.2 <26.3",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.11+kotlin.2.3.21",
    "yet-another-minecraft-bingo": ">=2.15.0 <2.16"
  },
  "contact": {
    "homepage": "https://github.com/HalfMirrorWorm/random-perks-bingo",
    "sources": "https://github.com/HalfMirrorWorm/random-perks-bingo"
  }
}
